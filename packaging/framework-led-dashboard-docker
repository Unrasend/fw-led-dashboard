#!/usr/bin/env bash
# Run the Framework LED Matrix dashboard in Docker; the systemd user service starts it after
# `install.sh --docker`. The container gets only what the daemon needs:
#   - the LED Matrix serial ports: /dev without what is mounted under it (no terminals, no
#     shared memory), and a device rule that lets it open ttyACM devices and nothing else;
#   - sysfs, read-only as Docker always mounts it: ports, battery, temperatures, GPU load;
#   - the PipeWire and Pulse sockets, for the equalizer;
#   - a folder of its own for the control socket the tray and the settings window use;
#   - the config (read-only), the display settings and the location cache;
#   - a network of its own, for the weather: a user-defined Docker network, whose DNS asks the
#     desktop's resolver from the desktop's side - so it works with resolvers a container
#     could not reach itself (NetBird, Tailscale, systemd-resolved behind a firewall).
#     LED_DASHBOARD_DOCKER_NETWORK=host shares the desktop's network instead, as a last resort:
#     the container then reaches whatever listens on the desktop's loopback.
# It runs as you, without capabilities or new privileges, on a read-only root.
#
#   framework-led-dashboard-docker           run in the foreground until SIGTERM
#   framework-led-dashboard-docker --print   print the docker command instead
#   framework-led-dashboard-docker --remove  remove a container left behind
set -euo pipefail

NAME=framework-led-dashboard
NETWORK=${LED_DASHBOARD_DOCKER_NETWORK:-framework-led-dashboard}
IMAGE=${LED_DASHBOARD_IMAGE:-framework-led-dashboard:@VERSION@}
TTY_ACM_MAJOR=166  # /dev/ttyACM*, the LED Matrix modules

uid=$(id -u)
gid=$(id -g)
runtime=${XDG_RUNTIME_DIR:-/run/user/$uid}
inside=/run/user/$uid
config=${XDG_CONFIG_HOME:-$HOME/.config}/framework-led-dashboard
state=${XDG_STATE_HOME:-$HOME/.local/state}/framework-led-dashboard
cache=${XDG_CACHE_HOME:-$HOME/.cache}/framework-led-dashboard
COMMAND=()

bind() {
    printf -- '--mount=type=bind,src=%s,dst=%s%s' "$1" "$2" "${3:-}"
}

# Groups that own the serial ports (uucp, dialout), for systems that grant them by group
# rather than to the logged-in user.
port_groups() {
    local port
    {
        for port in /dev/ttyACM*; do
            [[ -e "$port" ]] && stat -c %g "$port"
        done
        getent group uucp dialout | cut -d: -f3
    } | sort -un
}

# The desktop's time zone, e.g. Europe/Prague: without IP geolocation (the container cannot
# see a VPN, so it never looks the IP up) the weather falls back to its city.
time_zone() {
    if [[ -n "${TZ:-}" && "${TZ#:}" != /* ]]; then
        printf '%s' "${TZ#:}"
        return
    fi
    local target
    target=$(readlink -f /etc/localtime 2>/dev/null) || return 0
    if [[ "$target" == */zoneinfo/* ]]; then
        printf '%s' "${target#*/zoneinfo/}"
    fi
}

build_command() {
    COMMAND=(docker run --rm --name "$NAME" --init
        --network "$NETWORK"
        --user "$uid:$gid"
        --read-only --tmpfs /tmp
        --cap-drop ALL --security-opt no-new-privileges
        --pids-limit 64 --memory 256m
        "$(bind /dev /dev ,readonly,bind-recursive=disabled)"
        --device-cgroup-rule "c $TTY_ACM_MAJOR:* rmw"
        "$(bind "$config" /config ,readonly)"
        "$(bind "$state" /state/framework-led-dashboard)"
        "$(bind "$cache" /cache/framework-led-dashboard)"
        "$(bind "$runtime/framework-led-dashboard" "$inside/framework-led-dashboard")"
        --env "XDG_RUNTIME_DIR=$inside"
        --env XDG_STATE_HOME=/state
        --env XDG_CACHE_HOME=/cache
        --env HOME=/tmp)
    local group socket zone
    while read -r group; do
        COMMAND+=(--group-add "$group")
    done < <(port_groups)
    for socket in pipewire-0 pulse/native; do
        if [[ -S "$runtime/$socket" ]]; then
            COMMAND+=("$(bind "$runtime/$socket" "$inside/$socket")")
        fi
    done
    zone=$(time_zone)
    if [[ -n "$zone" ]]; then
        COMMAND+=(--env "TZ=$zone")
    fi
    COMMAND+=("$IMAGE" --run /config/config.toml)
}

main() {
    case "${1:-}" in
        --remove)
            docker rm --force "$NAME" >/dev/null 2>&1 || true
            return
            ;;
        --print)
            build_command
            printf '%q ' "${COMMAND[@]}"
            printf '\n'
            return
            ;;
        "") ;;
        *)
            printf 'usage: %s [--print | --remove]\n' "$0" >&2
            return 2
            ;;
    esac
    [[ -f "$config/config.toml" ]] || {
        printf 'no %s; run install.sh first\n' "$config/config.toml" >&2
        return 2
    }
    local folder
    for folder in "$state" "$cache" "$runtime/framework-led-dashboard"; do
        mkdir -p "$folder"
        chmod 700 "$folder"
    done
    build_command
    docker rm --force "$NAME" >/dev/null 2>&1 || true  # one left by a crash
    if [[ "$NETWORK" == "$NAME" ]] && ! docker network inspect "$NETWORK" >/dev/null 2>&1; then
        docker network create "$NETWORK" >/dev/null
    fi
    exec "${COMMAND[@]}"
}

main "$@"
